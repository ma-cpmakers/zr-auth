{
    "name": "zeiras/zr-auth",
    "description": "Zeiras: la parte comune dei moduli zr-* (ingresso via zr-home con OpenID Connect, sessione nel workspace, avvisi, barra comune).",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "firebase/php-jwt": "^7.0",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Zeiras\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zeiras\\Auth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zeiras\\Auth\\ZrAuthServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.4.26"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
