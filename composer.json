{
    "name": "zeiras/zr-auth",
    "description": "Zeiras: il pacchetto dei frontend zr-* — sessione col gettone del backoffice, client delle API /v1, guardia sulle rotte, backoffice finto per i test. Nessun database.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Zeiras\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zeiras\\Auth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zeiras\\Auth\\ZrAuthServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.4.26"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
